# Pins of skainet/iree-compiler-torq. TORQ_VERSION must equal the board's Torq runtime version.
# 2.0.x pairs with Astra SDK v2.4.0, 2.1.x with v2.5.0, 2.2.x with v2.5.0+/v2.6.0, 2.3.0 with v2.6.0 + the Torq 2.3.0
# astra-release runtime. 2.2.1 and newer wheels are manylinux_2_39 (TORQ_MANYLINUX=2_39,
# TORQ_BASE_IMAGE=python:3.12-slim-trixie); 2.0.0-2.2.0 are manylinux_2_28 (python:3.12-slim).
TORQ_VERSION=2.3.0
TORQ_MANYLINUX=2_39
TORQ_BASE_IMAGE=python:3.12-slim-trixie
